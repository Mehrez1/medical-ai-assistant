# Configuration pour le projet Assistant Orientation Médicale

# ========================================
# CONFIGURATION LLM - CHOISIR UN PROVIDER
# ========================================

# OPTION 1: Groq (Gratuit - Recommandé)
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq

# OPTION 2: Replicate - Llama 2 (Gratuit)
# REPLICATE_API_TOKEN=your_replicate_api_token_here
# LLM_PROVIDER=replicate

# OPTION 3: OpenAI (Payant)
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_PROVIDER=openai

# ========================================
# PARAMÈTRES LLM COMMUNS
# ========================================
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

